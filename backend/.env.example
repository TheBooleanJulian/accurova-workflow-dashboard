# backend/.env.example
# Copy to .env and fill in — never commit .env

# Google service account with the sheet shared to it as Editor.
# GOOGLE_SERVICE_ACCOUNT_KEY is the private_key field from the service
# account's JSON key — keep the \n escapes, they're unescaped at runtime.
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1ucQvqmJji7kvbrUJTCRZFZibomG5belAWQrQutu4VFQ

# URL of your deployed frontend (for CORS)
FRONTEND_URL=https://workflow.accurova.com

PORT=3001
