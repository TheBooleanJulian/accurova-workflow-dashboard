# backend/.env.example
# Copy to .env and fill in — never commit .env

# OAuth, not a service-account key — many Google Workspace orgs block
# service-account key creation. GOOGLE_OAUTH_CLIENT_ID/SECRET come from a
# "Desktop app" OAuth client in Google Cloud Console (the same one the
# PhotoVault Tracker uses is fine). GOOGLE_OAUTH_REFRESH_TOKEN is generated
# once by running: node scripts/get-oauth-refresh-token.js
# See README "Google account setup".
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx
GOOGLE_OAUTH_REFRESH_TOKEN=xxxx
GOOGLE_SHEET_ID=1ucQvqmJji7kvbrUJTCRZFZibomG5belAWQrQutu4VFQ

# URL of your deployed frontend (for CORS)
FRONTEND_URL=https://workflow.accurova.com

# Password for the admin dashboard (POST /admin/login). The backend issues a
# signed, self-expiring session token on success — the password itself is
# never sent again after login. Generate one with: openssl rand -hex 16
ADMIN_PASSWORD=change-me

PORT=3001
