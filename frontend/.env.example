# frontend/.env.example
# Copy to .env.local — never commit

# In dev, Vite proxy handles /api → localhost:3001 automatically.
# In production (Zeabur), set this to your deployed backend URL.
VITE_API_URL=https://accurova-workflow-api.zeabur.app

# Must match the backend's API_KEY. Baked into the built JS bundle at build
# time — not a secret once shipped, just a shared gate paired with the
# access control in front of the site (see README security section).
VITE_API_KEY=change-me
