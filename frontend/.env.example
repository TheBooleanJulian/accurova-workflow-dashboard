# frontend/.env.example
# Copy to .env.local — never commit

# In dev, Vite proxy handles /api → localhost:3001 automatically.
# In production (Zeabur), set this to your deployed backend URL.
VITE_API_URL=https://accurova-workflow-api.zeabur.app

# No build-time secret needed anymore: the public dashboard is unauthenticated
# and the admin dashboard logs in at runtime against the backend's
# ADMIN_PASSWORD (see backend/.env.example), getting back a session token
# it stores in the browser. Nothing admin-related is baked into the bundle.
